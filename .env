# Flask Secret Key - Change this to a strong random key in production
SECRET_KEY=super-secret-cyber-key-9988

# SQLite Database URL (default points to instance/network_sniffer.db)
# For production, you may switch to PostgreSQL or MySQL
DATABASE_URL=sqlite:///instance/network_sniffer.db

# Packet Capture Settings
MAX_PACKET_STORAGE=100000
PORT_SCAN_THRESHOLD=20

